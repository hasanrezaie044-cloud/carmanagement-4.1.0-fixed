{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug",
        "applicationArchivePath": "android/app/build/outputs/apk/debug/*.apk",
        "withoutCredentials": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "applicationArchivePath": "android/app/build/outputs/apk/release/*.apk",
        "credentialsSource": "remote",
        "image": "ubuntu-26.04-jdk-17-ndk-r27b-sdk-57"
      },
      "credentialsSource": "remote"
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease",
        "applicationArchivePath": "android/app/build/outputs/bundle/release/*.aab",
        "credentialsSource": "remote",
        "image": "ubuntu-26.04-jdk-17-ndk-r27b-sdk-57"
      },
      "credentialsSource": "remote"
    }
  },
  "submit": {
    "production": {}
  }
}
